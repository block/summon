{
  "name": "@summon-internal/server",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./ghost": {
      "types": "./dist/ghost/index.d.ts",
      "import": "./dist/ghost/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@design-intelligence/ghost": "file:../../vendor/design-intelligence-ghost-0.20.0.tgz",
    "@summon-internal/engine": "workspace:*",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "tsx": "^4.7.0"
  },
  "private": true
}
