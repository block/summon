{
  "name": "@summon-internal/surface-vm",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-vm-source.mjs && tsc -p tsconfig.build.json",
    "build:vm-source": "node scripts/build-vm-source.mjs",
    "test": "node scripts/build-vm-source.mjs --check && tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "happy-dom": "^15.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "private": true,
  "dependencies": {
    "quickjs-emscripten": "^0.32.0"
  }
}
