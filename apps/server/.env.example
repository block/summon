# Pick one configured provider for server-default generation.
# The Generate workbench can override this per run when multiple keys are set.
SUMMON_MODEL_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Optional model overrides.
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_SMALL_MODEL=claude-haiku-4-5
# OPENAI_MODEL=gpt-5
# OPENAI_SMALL_MODEL=gpt-5-mini
# GEMINI_MODEL=gemini-2.5-pro
# GEMINI_SMALL_MODEL=gemini-2.5-flash

PORT=3001

# Optional Ghost steering roots for /generate.html.
# Format: id=/absolute/path/to/repo,another=/absolute/path/to/repo
# Canonical roots contain .ghost/fingerprint/manifest.yml.
# Legacy .ghost/fingerprint.yml roots are still bridged for compatibility.
# SUMMON_GHOST_ROOTS=checkout=/absolute/path/to/checkout

# Semantic surface (archetype) selection. Default-on. The utility model picks
# the best-fitting composition archetype for the prompt; the full fingerprint
# vocabulary is always supplied regardless, so selection only focuses the lead.
# Set to 0 to disable and always anchor at `core`.
# SUMMON_GHOST_SURFACE_SELECT=1

# Design-fidelity repair loop. When >0, after a surface passes runtime/safety
# validation the accepted source is scored against the fingerprint's routed
# conformance checks; a failed HIGH-severity check triggers up to N additional
# repair passes with design hints. Default 0 (conformance stays advisory).
# Costs an extra utility-model call (plus a generation call per repair).
# SUMMON_GHOST_FIDELITY_REPAIR=1

